<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ProfileController"
            prefHeight="700" prefWidth="900"
            style="-fx-background-color: linear-gradient(to bottom, #f8fafc, #e2e8f0);">

    <top>
        <HBox style="-fx-background-color: rgb(1,10,34); -fx-padding: 16 24;" spacing="20" alignment="CENTER_LEFT">
            <Button fx:id="backBtn" text="← Back"
                    style="-fx-text-fill: #FFA500; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                    onAction="#handleBack" />
            <Label fx:id="titleLabel" text="My Profile" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="roleLabel" text="" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="0">
            <padding><Insets top="32" right="48" bottom="32" left="48"/></padding>

            <!-- Card -->
            <VBox fx:id="formCard" spacing="20" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4); -fx-padding: 28; -fx-max-width: 520;">
                <Label text="Account details" style="-fx-text-fill: #0f172a; -fx-font-size: 18; -fx-font-weight: bold;"/>

                <Label text="Full name" style="-fx-text-fill: #475569; -fx-font-size: 12;"/>
                <TextField fx:id="fullNameField" promptText="Your name" style="-fx-padding: 10; -fx-font-size: 14;"/>

                <Label text="Email" style="-fx-text-fill: #475569; -fx-font-size: 12;"/>
                <TextField fx:id="emailField" promptText="email@example.com" style="-fx-padding: 10; -fx-font-size: 14;"/>

                <Label text="Phone" style="-fx-text-fill: #475569; -fx-font-size: 12;"/>
                <TextField fx:id="phoneField" promptText="+33 1 23 45 67 89" style="-fx-padding: 10; -fx-font-size: 14;"/>

                <!-- Client: delivery address -->
                <VBox fx:id="clientAddressBox" spacing="6" visible="false" managed="false">
                    <Label text="Delivery address (for orders)" style="-fx-text-fill: #475569; -fx-font-size: 12;"/>
                    <TextArea fx:id="addressField" promptText="Street, city, postal code" wrapText="true" prefRowCount="2" style="-fx-padding: 10; -fx-font-size: 14;"/>
                </VBox>

                <!-- Delivery man: vehicle & work address -->
                <VBox fx:id="deliveryExtraBox" spacing="12" visible="false" managed="false">
                    <Separator/>
                    <Label text="Delivery driver info" style="-fx-text-fill: #0f172a; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label text="Vehicle type" style="-fx-text-fill: #475569; -fx-font-size: 12;"/>
                    <TextField fx:id="vehicleTypeField" promptText="e.g. Motorcycle, Car" style="-fx-padding: 10; -fx-font-size: 14;"/>
                    <Label text="Vehicle number" style="-fx-text-fill: #475569; -fx-font-size: 12;"/>
                    <TextField fx:id="vehicleNumberField" promptText="Plate or ID" style="-fx-padding: 10; -fx-font-size: 14;"/>
                    <Label text="Address (work / home)" style="-fx-text-fill: #475569; -fx-font-size: 12;"/>
                    <TextArea fx:id="deliveryAddressField" promptText="Optional" wrapText="true" prefRowCount="2" style="-fx-padding: 10; -fx-font-size: 14;"/>
                </VBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button fx:id="saveBtn" text="Save changes" onAction="#handleSave"
                            style="-fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 24; -fx-cursor: hand; -fx-background-radius: 8;"/>
                    <Button fx:id="deleteAccountBtn" text="Delete my account" onAction="#handleDeleteAccount"
                            visible="false" managed="false"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-padding: 12 24; -fx-cursor: hand; -fx-background-radius: 8;"/>
                </HBox>
            </VBox>

            <Label fx:id="messageLabel" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 12;" wrapText="true" maxWidth="520"/>
        </VBox>
    </center>
</BorderPane>
