<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.AdminDelivery"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: rgb(1,10,34);" spacing="0">

            <!-- ═══ NAVBAR ═══ -->
            <HBox style="-fx-background-color: rgb(1,10,34); -fx-padding: 15;" spacing="40" alignment="CENTER_LEFT">

                <!-- Logo -->
                <VBox alignment="CENTER" prefWidth="100">
                    <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                        <image><Image url="@images/logo.png" /></image>
                    </ImageView>
                </VBox>

                <!-- Nav Links -->
                <HBox spacing="30" alignment="CENTER_LEFT">
                    <Button fx:id="aboutBtn" text="About"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleAbout" />
                    <Button fx:id="menuBtn" text="Menu"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleMenu" />
                    <Button fx:id="reserveBtn" text="Reservations"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleReservations" />
                    <Button fx:id="eventsBtn" text="Events"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleEvents" />
                    <Button fx:id="rapportBtn" text="Reports"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleRapport" />
                    <Button fx:id="contactBtn" text="Contact"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleContact" />
                    <Button fx:id="deliveryBtn" text="Delivery ▾"
                            style="-fx-text-fill: #FFA500; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand; -fx-font-weight: bold;"
                            onAction="#handleDelivery" />
                </HBox>

                <!-- Spacer -->
                <HBox HBox.hgrow="ALWAYS" />

                <!-- Right Buttons -->
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button fx:id="cartBtn" text="🛒"
                            style="-fx-font-size: 18; -fx-background-color: #FFA500; -fx-text-fill: white; -fx-padding: 10 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#handleCart" />
                    <Button fx:id="profileBtn" text="👤 Profile"
                            style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#handleProfile" />
                    <Button fx:id="callBtn" text="☎ Call"
                            style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#handleCall" />
                </HBox>
            </HBox>

            <!-- ═══ PAGE HEADER ═══ -->
            <VBox style="-fx-background-color: rgb(1,10,34); -fx-padding: 10 20 20 20;" spacing="15">
                <Label text="Admin Delivery Management" style="-fx-text-fill: #FFA500;">
                    <font>
                        <Font name="Arial Bold" size="24.0" />
                    </font>
                </Label>

                <!-- Search and Filter Bar -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" prefWidth="350"
                               promptText="🔍 Search by recipient name, phone, or delivery ID..."
                               style="-fx-padding: 10; -fx-font-size: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 20; -fx-background-color: white;"
                               onKeyReleased="#performSearch" />

                    <ComboBox fx:id="statusFilter" prefWidth="150"
                              promptText="Filter by Status"
                              style="-fx-padding: 8; -fx-font-size: 12; -fx-border-radius: 5;"
                              onAction="#filterByStatus">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="ALL" />
                                <String fx:value="PENDING" />
                                <String fx:value="ON_DELIVERY" />
                                <String fx:value="DELIVERED" />
                                <String fx:value="CANCELED" />
                            </FXCollections>
                        </items>
                    </ComboBox>

                    <Button text="🔄 Refresh"
                            style="-fx-text-fill: white; -fx-font-size: 12; -fx-background-color: transparent; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 1; -fx-border-radius: 20;"
                            onAction="#refreshData" />
                </HBox>
            </VBox>

        </VBox>
    </top>

    <!-- Table -->
    <center>
        <VBox style="-fx-padding: 20; -fx-background-color: #f5f5f5;">
            <TableView fx:id="deliveryTable"
                       style="-fx-font-size: 12; -fx-padding: 10;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="ID" prefWidth="50" fx:id="idColumn" />
                    <TableColumn text="Order ID" prefWidth="70" fx:id="orderIdColumn" />
                    <TableColumn text="Delivery Man" prefWidth="120" fx:id="deliveryManColumn" />
                    <TableColumn text="Recipient" prefWidth="130" fx:id="nameColumn" />
                    <TableColumn text="Phone" prefWidth="110" fx:id="phoneColumn" />
                    <TableColumn text="Address" prefWidth="180" fx:id="addressColumn" />
                    <TableColumn text="Status" prefWidth="90" fx:id="statusColumn" />
                    <TableColumn text="Created" prefWidth="130" fx:id="createdColumn" />
                    <TableColumn text="Action" prefWidth="100" fx:id="actionsColumn" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Statistics Bar -->
    <bottom>
        <HBox style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;"
              spacing="30"
              alignment="CENTER_LEFT">

            <VBox spacing="5">
                <Label text="TOTAL DELIVERIES"
                       style="-fx-text-fill: #888; -fx-font-size: 10; -fx-font-weight: bold;" />
                <Label fx:id="totalLabel"
                       text="0"
                       style="-fx-text-fill: rgb(1,10,34); -fx-font-size: 18; -fx-font-weight: bold;" />
            </VBox>

            <VBox spacing="5">
                <Label text="PENDING"
                       style="-fx-text-fill: #f59e0b; -fx-font-size: 10; -fx-font-weight: bold;" />
                <Label fx:id="pendingLabel"
                       text="0"
                       style="-fx-text-fill: #f59e0b; -fx-font-size: 16; -fx-font-weight: bold;" />
            </VBox>

            <VBox spacing="5">
                <Label text="ON DELIVERY"
                       style="-fx-text-fill: #3b82f6; -fx-font-size: 10; -fx-font-weight: bold;" />
                <Label fx:id="onDeliveryLabel"
                       text="0"
                       style="-fx-text-fill: #3b82f6; -fx-font-size: 16; -fx-font-weight: bold;" />
            </VBox>

            <VBox spacing="5">
                <Label text="DELIVERED"
                       style="-fx-text-fill: #10b981; -fx-font-size: 10; -fx-font-weight: bold;" />
                <Label fx:id="deliveredLabel"
                       text="0"
                       style="-fx-text-fill: #10b981; -fx-font-size: 16; -fx-font-weight: bold;" />
            </VBox>

            <VBox spacing="5">
                <Label text="CANCELED"
                       style="-fx-text-fill: #ef4444; -fx-font-size: 10; -fx-font-weight: bold;" />
                <Label fx:id="canceledLabel"
                       text="0"
                       style="-fx-text-fill: #ef4444; -fx-font-size: 16; -fx-font-weight: bold;" />
            </VBox>
        </HBox>
    </bottom>

</BorderPane>