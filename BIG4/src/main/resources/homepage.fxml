<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.homepage"
            fx:id="rootPane"
            style="-fx-background-color: #f5f5f5;">

    <!-- Navigation Bar (Top) -->
    <top>
        <HBox style="-fx-background-color: rgb(1,10,34); -fx-padding: 15;" spacing="40" alignment="CENTER_LEFT">

            <!-- Logo Section -->
            <VBox alignment="CENTER" prefWidth="100">
                <!-- LOGO IMAGE - PUT YOUR logo.png IN src/main/resources/images/ -->
                <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                    <image>
                        <Image url="@images/logo.png" />
                    </image>
                </ImageView>
            </VBox>

            <!-- Navigation Links -->
            <HBox spacing="30" alignment="CENTER_LEFT">
                <Button fx:id="aboutBtn" text="About"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleAbout" />
                <Button fx:id="menuBtn" text="Menu"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleMenu" />
                <Button fx:id="reserveBtn" text="Reservations"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleReservations" />
                <Button fx:id="eventsBtn" text="Events"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleEvents" />
                <Button fx:id="rapportBtn" text="Reports"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleRapport" />
                <Button fx:id="adminBtn" text="Admin"
                    style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-underline: false; -fx-cursor: hand;"
                    onAction="#handleAdmin" />
                <Button fx:id="contactBtn" text="Contact"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleContact" />
                <Button fx:id="deliveryBtn" text="Delivery"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleDelivery" />
            </HBox>

            <!-- Spacer to push buttons to the right -->
            <HBox HBox.hgrow="ALWAYS" />

            <!-- Right Side Buttons -->
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button fx:id="cartBtn" text="🛒"
                        style="-fx-font-size: 18; -fx-background-color: #FFA500; -fx-text-fill: white; -fx-padding: 10 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                        onAction="#handleCart" />
                <Button fx:id="profileBtn" text="👤 Profile"
                        style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                        onAction="#handleProfile" />
                <Button fx:id="callBtn" text="☎ Call"
                        style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                        onAction="#handleCall" />
            </HBox>
        </HBox>
    </top>

    <!-- Welcome Content (Center) -->
    <center>
        <StackPane>
            <!-- BACKGROUND IMAGE - PUT YOUR background.png IN src/main/resources/images/ -->
            <ImageView fitHeight="710" fitWidth="1250" preserveRatio="false">
                <image>
                    <Image url="@images/BG.png" />
                </image>
            </ImageView>

            <!-- Dark Overlay for better text visibility -->
            <VBox style="-fx-background-color: rgba(0, 0, 0, 0.4);" />

            <!-- Welcome Content -->
            <VBox spacing="40" alignment="CENTER">
                <padding>
                    <Insets top="100" right="100" bottom="100" left="100" />
                </padding>

                <!-- Heading -->
                <VBox alignment="CENTER" spacing="10">
                    <Label text="Welcome to " style="-fx-text-fill: white;">
                        <font>
                            <Font name="Arial Bold" size="56.0" />
                        </font>
                    </Label>
                    <Label text="Big4" style="-fx-text-fill: #FFA500;">
                        <font>
                            <Font name="Arial Bold" size="56.0" />
                        </font>
                    </Label>
                    <Label text="Where coffee excellence meets gastronomy"
                           style="-fx-text-fill: white;">
                        <font>
                            <Font size="18.0" />
                        </font>
                    </Label>
                </VBox>

                <!-- Action Buttons -->
                <HBox spacing="30" alignment="CENTER">
                    <Button fx:id="viewMenuBtn" text="View Menu"
                            style="-fx-font-size: 16; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 15 50; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-background-color: #FFA500;"
                            onAction="#handleViewMenu" />
                    <Button fx:id="reserveTableBtn" text="Reserve a Table"
                            style="-fx-font-size: 16; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 40; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 2;"
                            onAction="#handleReserveTable" />
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
