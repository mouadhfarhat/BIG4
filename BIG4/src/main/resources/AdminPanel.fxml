<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.AdminPanelController"
            styleClass="admin-panel-root"
            stylesheets="@styles/main.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              styleClass="admin-top-bar">
            <Label text="Admin"
                   styleClass="admin-top-title" />

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="dashboardBtn" text="Dashboard"
                    onAction="#showDashboard"
                    styleClass="admin-nav-link" />
                <Button fx:id="menuAdminBtn" text="Menu &amp; Dishes"
                        onAction="#showMenuAdmin"
                        styleClass="admin-nav-link" />
                <Button fx:id="ingredientsBtn" text="Ingredients"
                        onAction="#showIngredients"
                        styleClass="admin-nav-link" />
                <Button fx:id="wasteBtn" text="Waste Records"
                        onAction="#showWasteRecords"
                        styleClass="admin-nav-link" />
            </HBox>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentHolder" styleClass="admin-content-holder" />
    </center>

</BorderPane>
