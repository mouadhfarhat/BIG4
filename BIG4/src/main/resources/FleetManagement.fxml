<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.FleetManagementController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: rgb(1,10,34);" spacing="0">
            <HBox style="-fx-padding: 15;" spacing="20" alignment="CENTER_LEFT">
                <Button fx:id="backBtn" text="← Back to Admin"
                        style="-fx-text-fill: #FFA500; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleBack" />
                <Label text="Fleet — Assign car to delivery man (1 to 1)" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;">
                    <font><Font name="Arial Bold" size="20"/></font>
                </Label>
            </HBox>
            <Label text="Add cars to the fleet, then assign each car to one delivery driver. One car = one driver." style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12; -fx-padding: 0 15 12 15;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 24;">
            <!-- Add car -->
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
                <Label text="Add new car:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="makeField" promptText="Make" prefWidth="120" style="-fx-padding: 8;"/>
                <TextField fx:id="modelField" promptText="Model" prefWidth="120" style="-fx-padding: 8;"/>
                <TextField fx:id="plateField" promptText="License plate" prefWidth="120" style="-fx-padding: 8;"/>
                <TextField fx:id="typeField" promptText="Type (e.g. Sedan)" prefWidth="100" style="-fx-padding: 8;"/>
                <Button fx:id="addCarBtn" text="Add car" onAction="#handleAddCar"
                        style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 6;"/>
            </HBox>

            <!-- Cars table -->
            <Label text="Fleet" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <TableView fx:id="carsTable" prefHeight="400" style="-fx-background-color: white; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="carIdCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="makeCol" text="Make" prefWidth="100"/>
                    <TableColumn fx:id="modelCol" text="Model" prefWidth="100"/>
                    <TableColumn fx:id="plateCol" text="License plate" prefWidth="120"/>
                    <TableColumn fx:id="typeCol" text="Type" prefWidth="80"/>
                    <TableColumn fx:id="assignedToCol" text="Assigned to" prefWidth="200"/>
                    <TableColumn fx:id="carActionsCol" text="Actions" prefWidth="260"/>
                </columns>
            </TableView>
            <Label fx:id="messageLabel" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 12;" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
