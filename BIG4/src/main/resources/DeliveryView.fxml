<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.DeliveryView"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: rgb(1,10,34);" spacing="0">

            <!-- ═══ NAVBAR ═══ -->
            <HBox style="-fx-background-color: rgb(1,10,34); -fx-padding: 15;" spacing="40" alignment="CENTER_LEFT">

                <!-- Logo -->
                <VBox alignment="CENTER" prefWidth="100">
                    <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                        <image><Image url="@images/logo.png" /></image>
                    </ImageView>
                </VBox>

                <!-- Nav Links -->
                <HBox spacing="30" alignment="CENTER_LEFT">
                    <Button fx:id="aboutBtn"   text="About"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleAbout" />
                    <Button fx:id="menuBtn"    text="Menu"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleMenu" />
                    <Button fx:id="reserveBtn" text="Reservations"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleReservations" />
                    <Button fx:id="eventsBtn"  text="Events"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleEvents" />
                    <Button fx:id="rapportBtn" text="Reports"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleRapport" />
                    <Button fx:id="contactBtn" text="Contact"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleContact" />
                    <Button fx:id="deliveryBtn" text="Delivery ▾"
                            style="-fx-text-fill: #FFA500; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand; -fx-font-weight: bold;"
                            onAction="#handleDelivery" />
                </HBox>

                <!-- Spacer -->
                <HBox HBox.hgrow="ALWAYS" />

                <!-- Right Buttons -->
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button fx:id="cartBtn" text="🛒"
                            style="-fx-font-size: 18; -fx-background-color: #FFA500; -fx-text-fill: white; -fx-padding: 10 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#handleCart" />
                    <Button fx:id="profileBtn" text="👤 Profile"
                            style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#handleProfile" />
                    <Button fx:id="callBtn" text="☎ Call"
                            style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#handleCall" />
                    <Button fx:id="logoutBtn" text="Log out"
                            style="-fx-font-size: 14; -fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-padding: 12 20; -fx-cursor: hand;"
                            onAction="#handleLogout" />
                </HBox>
            </HBox>

            <!-- ═══ PAGE HEADER ═══ -->
            <VBox style="-fx-background-color: rgb(1,10,34); -fx-padding: 10 20 20 20;" spacing="6">
                <HBox spacing="40" alignment="CENTER_LEFT">
                    <Label text="My Deliveries" style="-fx-text-fill: #FFA500;">
                        <font><Font name="Arial Bold" size="24.0" /></font>
                    </Label>
                    <HBox HBox.hgrow="ALWAYS" />
                    <Button text="🔄 Refresh"
                            style="-fx-text-fill: white; -fx-font-size: 12; -fx-background-color: transparent; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 1; -fx-border-radius: 20;"
                            onAction="#refreshList" />
                </HBox>
                <Label fx:id="statsLabel" style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 11;" />
            </VBox>

        </VBox>
    </top>

    <!-- Table -->
    <center>
        <VBox style="-fx-padding: 20; -fx-background-color: #f5f5f5;">
            <TableView fx:id="deliveryTable" style="-fx-font-size: 12; -fx-padding: 10;">
                <columns>
                    <TableColumn text="Delivery ID"    prefWidth="70"  fx:id="idColumn" />
                    <TableColumn text="Order ID"       prefWidth="70"  fx:id="orderIdColumn" />
                    <TableColumn text="Recipient Name" prefWidth="130" fx:id="nameColumn" />
                    <TableColumn text="Phone"          prefWidth="110" fx:id="phoneColumn" />
                    <TableColumn text="Address"        prefWidth="200" fx:id="addressColumn" />
                    <TableColumn text="Status"         prefWidth="90"  fx:id="statusColumn" />
                    <TableColumn text="Created"        prefWidth="130" fx:id="createdColumn" />
                    <TableColumn text="Action"         prefWidth="110" fx:id="actionsColumn" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom -->
    <bottom>
        <HBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <Label text="💡 Click 'Update Status' to change delivery status"
                   style="-fx-text-fill: rgb(1,10,34); -fx-font-size: 12;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Label text="Last Updated: Now" style="-fx-text-fill: #888; -fx-font-size: 11;" />
        </HBox>
    </bottom>

</BorderPane>