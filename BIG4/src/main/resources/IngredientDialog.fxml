<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.IngredientDialogController"
            style="-fx-background-color: #f5f5f5;">
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <Label fx:id="titleLabel" text="Add Ingredient"
                   style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold;">
                <font><Font size="22.0"/></font>
            </Label>

            <ScrollPane style="-fx-border: none; -fx-padding: 0;" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                    <VBox spacing="5">
                        <Label text="Name *" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold;">
                            <font><Font size="12.0"/></font>
                        </Label>
                        <TextField fx:id="nameField" promptText="e.g. Fresh Tomatoes"
                                   style="-fx-padding: 12; -fx-font-size: 12; -fx-border-radius: 5; -fx-border-color: #DDD;"/>
                    </VBox>

                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Unit *" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold;">
                                <font><Font size="12.0"/></font>
                            </Label>
                            <TextField fx:id="unitField" promptText="e.g. kg"
                                       style="-fx-padding: 12; -fx-font-size: 12; -fx-border-radius: 5; -fx-border-color: #DDD;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Quantity *" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold;">
                                <font><Font size="12.0"/></font>
                            </Label>
                            <TextField fx:id="quantityField" promptText="e.g. 25.0"
                                       style="-fx-padding: 12; -fx-font-size: 12; -fx-border-radius: 5; -fx-border-color: #DDD;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Min Stock" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold;">
                                <font><Font size="12.0"/></font>
                            </Label>
                            <TextField fx:id="minStockField" promptText="e.g. 5"
                                       style="-fx-padding: 12; -fx-font-size: 12; -fx-border-radius: 5; -fx-border-color: #DDD;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Unit Cost" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold;">
                                <font><Font size="12.0"/></font>
                            </Label>
                            <TextField fx:id="unitCostField" promptText="e.g. 3.50"
                                       style="-fx-padding: 12; -fx-font-size: 12; -fx-border-radius: 5; -fx-border-color: #DDD;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Expiry Date" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold;">
                            <font><Font size="12.0"/></font>
                        </Label>
                        <DatePicker fx:id="expiryPicker" promptText="Select date" style="-fx-padding: 10; -fx-font-size: 12; -fx-border-radius: 5;"/>
                    </VBox>

                    <Label fx:id="validationLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                </VBox>
            </ScrollPane>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Cancel" onAction="#handleCancel"
                        style="-fx-padding: 12 40; -fx-font-size: 12; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-cursor: hand;"/>
                <Button fx:id="saveButton" text="Save" onAction="#handleSave"
                        style="-fx-padding: 12 40; -fx-font-size: 12; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
