<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controllers.FoodDonationController"
            style="-fx-background-color: #f5f5f5;">
    
    <!-- ========== TOP: HEADER ========== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #FF9800; -fx-padding: 20;">
            <Label text="🍽️ Food Donation Management" 
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back to Home" onAction="#handleBackToHome" 
                    style="-fx-background-color: white; -fx-text-fill: #FF9800; -fx-font-size: 15px; 
                           -fx-padding: 12 30; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    
    <!-- ========== CENTER: MAIN CONTENT ========== -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #f5f5f5;">
            
            <!-- ==================== TAB 1: EVENTS ==================== -->
            <Tab text="📅 Events" style="-fx-font-size: 14px;">
                <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f5f5f5;">
                    <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f5f5f5;">
                        
                        <!-- EVENTS TABLE -->
                        <VBox spacing="8">
                            <Label text="All Donation Events" 
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                            <TableView fx:id="donationEventsTable" prefHeight="450" minHeight="450" maxHeight="600"
                                       style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 2;">
                                <columns>
                                    <TableColumn fx:id="donationEventIdColumn" text="ID" prefWidth="70" 
                                               style="-fx-alignment: CENTER; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="donationEventDateColumn" text="Event Date" prefWidth="140" 
                                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="donationTotalQuantityColumn" text="Quantity" prefWidth="110" 
                                               style="-fx-alignment: CENTER; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="donationCharityNameColumn" text="Charity Name" prefWidth="240" 
                                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="donationStatusColumn" text="Status" prefWidth="140" 
                                               style="-fx-alignment: CENTER; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="donationDeliveryIdColumn" text="Delivery ID" prefWidth="110" 
                                               style="-fx-alignment: CENTER; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="donationCreatedAtColumn" text="Created At" prefWidth="170" 
                                               style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="donationUpdatedAtColumn" text="Updated At" prefWidth="170" 
                                               style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                        
                        <!-- EVENT FORM -->
                        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #FF9800; -fx-border-width: 3; -fx-background-radius: 8; -fx-border-radius: 8;">
                            <Label text="Create Event" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
                            
                            <!-- Row 1 -->
                            <HBox spacing="20">
                                <VBox spacing="6">
                                    <Label text="Event Date:" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                                    <DatePicker fx:id="donationEventDatePicker" prefWidth="180" 
                                              style="-fx-font-size: 13px;"/>
                                </VBox>
                                
                                <VBox spacing="6">
                                    <Label text="Event Name (Optional):" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="donationCharityNameField" prefWidth="280" 
                                             promptText="e.g., City Relief Event" style="-fx-font-size: 13px;"/>
                                </VBox>
                            </HBox>
                            
                            <!-- BUTTONS -->
                            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
                                <Button text="➕ Create Event" onAction="#handleAddDonationEvent" 
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                <Button text="🗑️ Delete" onAction="#handleDeleteDonationEvent" 
                                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                <Button text="🔄 Refresh" onAction="#handleRefreshEvents" 
                                        style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                            </HBox>
                        </VBox>
                        
                        <!-- STATISTICS -->
                        <HBox spacing="25" alignment="CENTER">
                            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #2196F3; -fx-border-width: 3; -fx-min-width: 180; -fx-background-radius: 8; -fx-border-radius: 8;">
                                <Label text="Total Events" style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                                <Label fx:id="totalEventsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
                            </VBox>
                            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #FF9800; -fx-border-width: 3; -fx-min-width: 180; -fx-background-radius: 8; -fx-border-radius: 8;">
                                <Label text="Pending" style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                                <Label fx:id="pendingEventsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
                            </VBox>
                            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #4CAF50; -fx-border-width: 3; -fx-min-width: 180; -fx-background-radius: 8; -fx-border-radius: 8;">
                                <Label text="Completed" style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                                <Label fx:id="completedEventsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
                            </VBox>
                        </HBox>
                        
                    </VBox>
                </ScrollPane>
            </Tab>
            
            <!-- ==================== TAB 2: ITEMS ==================== -->
            <Tab text="📦 Items" style="-fx-font-size: 14px;">
                <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f5f5f5;">
                    <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f5f5f5;">
                        
                        <!-- INFO BOX -->
                        <HBox spacing="12" style="-fx-background-color: #FFF9C4; -fx-padding: 15; -fx-border-color: #FBC02D; -fx-border-width: 2; -fx-background-radius: 5; -fx-border-radius: 5;">
                            <Label text="💡" style="-fx-font-size: 20px;"/>
                            <Label text="Important: Dish ID must exist in the dish table (check phpMyAdmin). Create the Event first before adding items!" 
                                   style="-fx-font-size: 14px; -fx-text-fill: #F57C00; -fx-wrap-text: true; -fx-font-weight: bold;"/>
                        </HBox>
                        
                        <!-- ITEMS TABLE (WITH SCROLLING!) -->
                        <VBox spacing="8">
                            <Label text="All Donation Items" 
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                            <TableView fx:id="donationItemsTable" prefHeight="450" minHeight="450" maxHeight="600"
                                       style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 2;">
                                <columns>
                                    <TableColumn fx:id="itemEventIdColumn" text="Event ID" prefWidth="150" 
                                               style="-fx-alignment: CENTER; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="itemIdColumn" text="Dish ID" prefWidth="150" 
                                               style="-fx-alignment: CENTER; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="itemNameColumn" text="Item Name" prefWidth="450" 
                                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="itemQuantityColumn" text="Quantity" prefWidth="230" 
                                               style="-fx-alignment: CENTER; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                        
                        <!-- ITEM FORM -->
                        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #FF9800; -fx-border-width: 3; -fx-background-radius: 8; -fx-border-radius: 8;">
                            <Label text="Add/Edit Item" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
                            
                            <HBox spacing="20">
                                <VBox spacing="6">
                                    <Label text="Event ID:" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="itemEventIdField" prefWidth="150" 
                                             promptText="e.g., 1" style="-fx-font-size: 13px;"/>
                                </VBox>
                                
                                <VBox spacing="6">
                                    <Label text="Dish ID:" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="itemDishIdField" prefWidth="150" 
                                             promptText="e.g., 1" style="-fx-font-size: 13px;"/>
                                </VBox>
                                
                                <VBox spacing="6">
                                    <Label text="Quantity:" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="itemQuantityField" prefWidth="180" 
                                             promptText="e.g., 50" style="-fx-font-size: 13px;"/>
                                </VBox>
                            </HBox>
                            
                            <!-- BUTTONS -->
                            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
                                <Button text="➕ Add Item" onAction="#handleAddDonationItem" 
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                <Button text="✏️ Update" onAction="#handleUpdateDonationItem" 
                                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                <Button text="🗑️ Delete" onAction="#handleDeleteDonationItem" 
                                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                <Button text="🔄 Refresh" onAction="#handleRefreshItems" 
                                        style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                            </HBox>
                        </VBox>
                        
                        <!-- STATISTICS -->
                        <HBox spacing="25" alignment="CENTER">
                            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #9C27B0; -fx-border-width: 3; -fx-min-width: 200; -fx-background-radius: 8; -fx-border-radius: 8;">
                                <Label text="Total Items" style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                                <Label fx:id="totalItemsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #9C27B0;"/>
                            </VBox>
                            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #FF5722; -fx-border-width: 3; -fx-min-width: 200; -fx-background-radius: 8; -fx-border-radius: 8;">
                                <Label text="Total Quantity" style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                                <Label fx:id="totalQuantityLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #FF5722;"/>
                            </VBox>
                        </HBox>
                        
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ==================== TAB 3: PLANNER ==================== -->
            <Tab text="🎯 Planner" style="-fx-font-size: 14px;">
                <BorderPane style="-fx-background-color: #f5f5f5; -fx-padding: 18;">
                    <center>
                        <SplitPane dividerPositions="0.42" prefHeight="620">
                            <items>
                                <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #ddd; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8;">
                                    <Label text="Created Events" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                                    <TableView fx:id="optimizationEventsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
                                        <columns>
                                            <TableColumn fx:id="optEventIdColumn" text="ID" prefWidth="70" style="-fx-alignment: CENTER;"/>
                                            <TableColumn fx:id="optEventDateColumn" text="Date" prefWidth="130"/>
                                            <TableColumn fx:id="optEventCharityColumn" text="Event" prefWidth="250"/>
                                            <TableColumn fx:id="optEventStatusColumn" text="Status" prefWidth="120" style="-fx-alignment: CENTER;"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </VBox>

                                <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #ddd; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8;">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Dishes Using Near-Expiring Ingredients (≤ 3 days)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="🔄 Refresh Suggestions" onAction="#handleRefreshOptimizationView"
                                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 5;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 6 0 6 0;">
                                        <Label text="Quantity:" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                                        <TextField fx:id="plannerDishQuantityField" prefWidth="110" promptText="e.g. 10"
                                                   style="-fx-font-size: 13px;"/>
                                        <Button text="➕ Add Selected Dish To Selected Event"
                                                onAction="#handleAddRecommendedDishToEvent"
                                                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 5;"/>
                                    </HBox>
                                    <TableView fx:id="recommendationTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
                                        <columns>
                                            <TableColumn fx:id="recDishIdColumn" text="Dish ID" prefWidth="90" style="-fx-alignment: CENTER;"/>
                                            <TableColumn fx:id="recDishNameColumn" text="Dish Name" prefWidth="250"/>
                                            <TableColumn fx:id="recMaxCountColumn" text="Max Count" prefWidth="110" style="-fx-alignment: CENTER;"/>
                                            <TableColumn fx:id="recUsageScoreColumn" text="Near Expiry Usage" prefWidth="140" style="-fx-alignment: CENTER;"/>
                                            <TableColumn fx:id="recCostScoreColumn" text="Cost Saving" prefWidth="120" style="-fx-alignment: CENTER;"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </VBox>
                            </items>
                        </SplitPane>
                    </center>
                </BorderPane>
            </Tab>
            
        </TabPane>
    </center>
    
</BorderPane>
