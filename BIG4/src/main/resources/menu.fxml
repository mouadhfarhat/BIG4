<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.MenuDishCrudController"
            prefWidth="900.0" prefHeight="600.0">

    <top>
        <VBox spacing="6" styleClass="header-section">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <children>
                <Label text="Menu &amp; Dish Management" styleClass="title-label"/>
                <Label text="Manage restaurant menus and associated dishes." styleClass="subtitle-label"/>
                <Label fx:id="lblSelectedMenu" text="Selected menu: (none)" styleClass="subtitle-label"/>
            </children>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.48">
            <items>
                <VBox spacing="18" padding="20" styleClass="content-card">
                    <children>
                        <Label text="Menus" styleClass="section-title"/>
                        <TableView fx:id="tvMenus" prefHeight="240" styleClass="elevated-table">
                            <columns>
                                <TableColumn fx:id="colMenuId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colMenuTitle" text="Title" prefWidth="140"/>
                                <TableColumn fx:id="colMenuDesc" text="Description" prefWidth="200"/>
                                <TableColumn fx:id="colMenuActive" text="Active" prefWidth="80"/>
                            </columns>
                        </TableView>

                        <GridPane hgap="12" vgap="12" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="30"/>
                                <ColumnConstraints percentWidth="70"/>
                            </columnConstraints>
                            <children>
                                <Label text="Title" GridPane.rowIndex="0" styleClass="form-label"/>
                                <TextField fx:id="tfMenuTitle" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                           promptText="e.g. Winter Specials" styleClass="form-input"/>

                                <Label text="Description" GridPane.rowIndex="1" styleClass="form-label"/>
                                <TextArea fx:id="taMenuDesc" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                          prefRowCount="3" wrapText="true" styleClass="form-textarea"
                                          promptText="Short menu description"/>

                                <Label text="Active" GridPane.rowIndex="2" styleClass="form-label"/>
                                <CheckBox fx:id="cbMenuActive" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <children>
                                <Button text="Add" onAction="#onAddMenu" styleClass="primary-button"/>
                                <Button text="Update" onAction="#onUpdateMenu" styleClass="secondary-button"/>
                                <Button text="Delete" onAction="#onDeleteMenu" styleClass="danger-button"/>
                                <Button text="Clear" onAction="#onClearMenu" styleClass="ghost-button"/>
                                <Button text="Refresh" onAction="#onRefreshMenus" styleClass="ghost-button"/>
                            </children>
                        </HBox>

                        <Label fx:id="lblMenuMsg" textFill="#dc2626"/>
                    </children>
                </VBox>

                <VBox spacing="18" padding="20" styleClass="content-card">
                    <children>
                        <Label text="Dishes" styleClass="section-title"/>
                        <TableView fx:id="tvDishes" prefHeight="240" styleClass="elevated-table">
                            <columns>
                                <TableColumn fx:id="colDishId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colDishName" text="Name" prefWidth="140"/>
                                <TableColumn fx:id="colDishDesc" text="Description" prefWidth="200"/>
                                <TableColumn fx:id="colDishPrice" text="Price" prefWidth="80"/>
                                <TableColumn fx:id="colDishAvail" text="Available" prefWidth="90"/>
                                <TableColumn fx:id="colDishStock" text="Stock" prefWidth="80"/>
                                <TableColumn fx:id="colDishImage" text="Image URL" prefWidth="160"/>
                            </columns>
                        </TableView>

                        <GridPane hgap="12" vgap="12" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="30"/>
                                <ColumnConstraints percentWidth="70"/>
                            </columnConstraints>
                            <children>
                                <Label text="Name" styleClass="form-label"/>
                                <TextField fx:id="tfDishName" GridPane.columnIndex="1" promptText="Dish name" styleClass="form-input"/>

                                <Label text="Description" GridPane.rowIndex="1" styleClass="form-label"/>
                                <TextArea fx:id="taDishDesc" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                          prefRowCount="3" wrapText="true" styleClass="form-textarea"
                                          promptText="Dish details"/>

                                <Label text="Price" GridPane.rowIndex="2" styleClass="form-label"/>
                                <TextField fx:id="tfDishPrice" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                           promptText="e.g. 14.50" styleClass="form-input"/>

                                <Label text="Available" GridPane.rowIndex="3" styleClass="form-label"/>
                                <CheckBox fx:id="cbDishAvailable" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Stock" GridPane.rowIndex="4" styleClass="form-label"/>
                                <TextField fx:id="tfDishStock" GridPane.rowIndex="4" GridPane.columnIndex="1"
                                           promptText="Quantity" styleClass="form-input"/>

                                <Label text="Image URL" GridPane.rowIndex="5" styleClass="form-label"/>
                                <TextField fx:id="tfDishImage" GridPane.rowIndex="5" GridPane.columnIndex="1"
                                           promptText="/images/dish.png" styleClass="form-input"/>
                            </children>
                        </GridPane>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <children>
                                <Button text="Add" onAction="#onAddDish" styleClass="primary-button"/>
                                <Button text="Update" onAction="#onUpdateDish" styleClass="secondary-button"/>
                                <Button text="Delete" onAction="#onDeleteDish" styleClass="danger-button"/>
                                <Button text="Clear" onAction="#onClearDish" styleClass="ghost-button"/>
                                <Button text="Refresh" onAction="#onRefreshDishes" styleClass="ghost-button"/>
                            </children>
                        </HBox>

                        <Label fx:id="lblDishMsg" textFill="#dc2626"/>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
