<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ClientMenuViewController"
            prefWidth="1100.0" prefHeight="700.0"
            styleClass="app-root"
            stylesheets="@client-menu.css">

    <!-- TOP HEADER -->
    <top>
        <HBox spacing="12" padding="18" styleClass="topbar">
            <VBox spacing="2">
                <Label text="Menus" styleClass="page-title"/>
                <Label text="Choisissez un menu, puis découvrez les plats." styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="tfSearch" promptText="Rechercher un plat..." styleClass="search"/>
        </HBox>
    </top>

    <!-- LEFT MENUS LIST -->
    <left>
        <VBox spacing="10" padding="18" styleClass="left-panel" prefWidth="320">
            <Label text="Liste des menus" styleClass="section-title"/>
            <ListView fx:id="lvMenus" styleClass="menu-list" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- CENTER DISHES GRID -->
    <center>
        <VBox spacing="12" padding="18" styleClass="content">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblSelectedMenu" text="Sélectionnez un menu" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cbSort" promptText="Trier" styleClass="sort"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="scroll" VBox.vgrow="ALWAYS">
                <content>
                    <FlowPane fx:id="fpDishes"
                              hgap="14" vgap="14"
                              prefWrapLength="720"
                              styleClass="dish-grid"
                              padding="2"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
