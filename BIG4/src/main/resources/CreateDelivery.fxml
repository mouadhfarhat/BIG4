<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.CreateDelivery"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: rgb(1,10,34);" spacing="0">

            <!-- ═══ NAVBAR ═══ -->
            <HBox style="-fx-background-color: rgb(1,10,34); -fx-padding: 15;" spacing="20" alignment="CENTER_LEFT">

                <!-- Logo -->
                <VBox alignment="CENTER" prefWidth="100">
                    <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                        <image><Image url="@images/logo.png" /></image>
                    </ImageView>
                </VBox>

                <!-- Nav Links -->
                <HBox spacing="18" alignment="CENTER_LEFT">
                    <Button fx:id="aboutBtn"   text="About"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleAbout" />
                    <Button fx:id="menuBtn"    text="Menu"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleMenu" />
                    <Button fx:id="reserveBtn" text="Reservations"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleReservations" />
                    <Button fx:id="eventsBtn"  text="Events"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleEvents" />
                    <Button fx:id="rapportBtn" text="Reports"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleRapport" />
                    <Button fx:id="contactBtn" text="Contact"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                            onAction="#handleContact" />
                    <Button fx:id="deliveryBtn" text="Delivery ▾"
                            style="-fx-text-fill: #FFA500; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand; -fx-font-weight: bold;"
                            onAction="#handleDelivery" />
                </HBox>

                <!-- Spacer -->
                <HBox HBox.hgrow="ALWAYS" />

                <!-- Right Buttons -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="cartBtn" text="🛒"
                            style="-fx-font-size: 18; -fx-background-color: #FFA500; -fx-text-fill: white; -fx-padding: 10 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#handleCart" />
                    <Button fx:id="profileBtn" text="👤 Profile"
                            style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#handleProfile" />
                    <Button fx:id="callBtn" text="☎ Call"
                            style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#handleCall" />
                </HBox>
            </HBox>

            <!-- ═══ PAGE HEADER ═══ -->
            <HBox style="-fx-background-color: rgb(1,10,34); -fx-padding: 10 20 20 20;" spacing="40" alignment="CENTER_LEFT">
                <Label text="Create Delivery" style="-fx-text-fill: #FFA500;">
                    <font><Font name="Arial Bold" size="24.0" /></font>
                </Label>
            </HBox>

        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-padding: 0; -fx-background-color: #f5f5f5;">
            <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 40;">

                <VBox spacing="20" maxWidth="1200" style="-fx-background-color: white; -fx-padding: 30; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                    <Label text="Delivery Information" style="-fx-text-fill: rgb(1,10,34); -fx-font-size: 18; -fx-font-weight: bold;" />

                    <VBox spacing="8">
                        <Label text="Order ID *" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold; -fx-font-size: 13;" />
                        <TextField fx:id="orderIdField" prefHeight="40" promptText="Enter your order ID"
                                   style="-fx-padding: 10; -fx-font-size: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #fafafa;" />
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Recipient Name *" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold; -fx-font-size: 13;" />
                        <TextField fx:id="recipientNameField" prefHeight="40" promptText="Full name of recipient"
                                   style="-fx-padding: 10; -fx-font-size: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #fafafa;" />
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Recipient Phone *" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold; -fx-font-size: 13;" />
                        <TextField fx:id="recipientPhoneField" prefHeight="40" promptText="Contact phone number"
                                   style="-fx-padding: 10; -fx-font-size: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #fafafa;" />
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Delivery Address *" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold; -fx-font-size: 13;" />
                        <TextArea fx:id="deliveryAddressField" prefHeight="90" wrapText="true" promptText="Complete delivery address"
                                  style="-fx-padding: 10; -fx-font-size: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #fafafa;" />
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Pickup Location (Optional)" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold; -fx-font-size: 13;" />
                        <TextField fx:id="pickupLocationField" prefHeight="40" promptText="Where to pick up the order"
                                   style="-fx-padding: 10; -fx-font-size: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #fafafa;" />
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Special Instructions (Optional)" style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold; -fx-font-size: 13;" />
                        <TextArea fx:id="deliveryNotesField" prefHeight="80" wrapText="true" promptText="Any special instructions for delivery"
                                  style="-fx-padding: 10; -fx-font-size: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #fafafa;" />
                    </VBox>

                </VBox>

                <HBox spacing="15" alignment="CENTER">
                    <Button text="Create Delivery" prefHeight="45" prefWidth="200"
                            style="-fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-padding: 12 30; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#createDelivery" />
                    <Button text="Clear Form" prefHeight="45" prefWidth="200"
                            style="-fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: #e0e0e0; -fx-text-fill: rgb(1,10,34); -fx-padding: 12 30; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                            onAction="#clearForm" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>