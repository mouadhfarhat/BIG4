<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.DeliverymanManagement"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox style="-fx-background-color: rgb(1,10,34); -fx-padding: 15;" spacing="40" alignment="CENTER_LEFT">

            <!-- Logo -->
            <VBox alignment="CENTER" prefWidth="100">
                <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                    <image><Image url="@images/logo.png" /></image>
                </ImageView>
            </VBox>

            <!-- Nav Links -->
            <HBox spacing="30" alignment="CENTER_LEFT">
                <Button fx:id="aboutBtn"   text="About"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleAbout" />
                <Button fx:id="menuBtn"    text="Menu"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleMenu" />
                <Button fx:id="reserveBtn" text="Reservations"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleReservations" />
                <Button fx:id="eventsBtn"  text="Events"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleEvents" />
                <Button fx:id="rapportBtn" text="Reports"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleRapport" />
                <Button fx:id="contactBtn" text="Contact"
                        style="-fx-text-fill: white; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand;"
                        onAction="#handleContact" />
                <Button fx:id="deliveryBtn" text="Delivery ▾"
                        style="-fx-text-fill: #FFA500; -fx-font-size: 14; -fx-background-color: transparent; -fx-cursor: hand; -fx-font-weight: bold;"
                        onAction="#handleDelivery" />
            </HBox>

            <!-- Spacer -->
            <HBox HBox.hgrow="ALWAYS" />

            <!-- Right Buttons -->
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button fx:id="cartBtn" text="🛒"
                        style="-fx-font-size: 18; -fx-background-color: #FFA500; -fx-text-fill: white; -fx-padding: 10 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                        onAction="#handleCart" />
                <Button fx:id="profileBtn" text="👤 Profile"
                        style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                        onAction="#handleProfile" />
                <Button fx:id="callBtn" text="☎ Call"
                        style="-fx-font-size: 14; -fx-background-color: #FFA500; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand;"
                        onAction="#handleCall" />
            </HBox>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 25;">

            <!-- Header -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Delivery Management System"
                               style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold;">
                            <font><Font size="28.0" /></font>
                        </Label>
                        <Label text="Manage delivery personnel, track assignments, and monitor performance"
                               style="-fx-text-fill: #666;">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </VBox>

                    <!-- Admin Delivery Button -->
                    <Button fx:id="adminDeliveryBtn" text="👮 Admin Deliveries Panel"
                            style="-fx-font-size: 13; -fx-font-weight: bold; -fx-background-color: rgb(1,10,34); -fx-text-fill: #FFA500; -fx-padding: 12 25; -fx-border-radius: 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-border-color: #FFA500; -fx-border-width: 1.5;"
                            onAction="#handleAdminDelivery" />
                </HBox>
            </VBox>

            <!-- Search and Filter -->
            <HBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                <TextField fx:id="searchField" promptText="Search by name, phone, or email..."
                           style="-fx-padding: 12; -fx-font-size: 12; -fx-pref-width: 300; -fx-border-radius: 5; -fx-border-color: #DDD;"
                           onKeyReleased="#handleSearch" />

                <ComboBox fx:id="statusFilter" promptText="Filter by Status"
                          style="-fx-padding: 10; -fx-font-size: 12; -fx-pref-width: 150; -fx-border-radius: 5;"
                          onAction="#handleFilterByStatus">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="ALL"/>
                            <String fx:value="ACTIVE"/>
                            <String fx:value="INACTIVE"/>
                            <String fx:value="ON_DELIVERY"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <Button text="Clear Filters"
                        style="-fx-padding: 12 25; -fx-font-size: 12; -fx-background-color: #FFA500; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-cursor: hand;"
                        onAction="#handleClearFilters" />

                <Region HBox.hgrow="ALWAYS" />

                <Button text="+ Add New Delivery Man"
                        style="-fx-padding: 12 25; -fx-font-size: 12; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-cursor: hand;"
                        onAction="#handleAddNew" />
            </HBox>

            <!-- Statistics -->
            <HBox spacing="15">
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label text="Total Delivery Men" style="-fx-text-fill: #666; -fx-font-size: 11;"><font><Font size="11.0" /></font></Label>
                    <Label fx:id="totalCountLabel" text="0" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"><font><Font size="24.0" /></font></Label>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label text="Active Delivery Men" style="-fx-text-fill: #666; -fx-font-size: 11;"><font><Font size="11.0" /></font></Label>
                    <Label fx:id="activeCountLabel" text="0" style="-fx-text-fill: #FFA500; -fx-font-weight: bold;"><font><Font size="24.0" /></font></Label>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label text="Average Rating" style="-fx-text-fill: #666; -fx-font-size: 11;"><font><Font size="11.0" /></font></Label>
                    <Label fx:id="avgRatingLabel" text="0.0 ⭐" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"><font><Font size="24.0" /></font></Label>
                </VBox>
            </HBox>

            <!-- Table -->
            <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <Label text="Delivery Personnel"
                       style="-fx-text-fill: rgb(1,10,34); -fx-font-weight: bold; -fx-padding: 0 0 15 0;">
                    <font><Font size="16.0" /></font>
                </Label>

                <TableView fx:id="deliveryTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="ID"             prefWidth="45"  fx:id="idColumn" />
                        <TableColumn text="Name"           prefWidth="100" fx:id="nameColumn" />
                        <TableColumn text="Phone"          prefWidth="90"  fx:id="phoneColumn" />
                        <TableColumn text="Email"          prefWidth="110" fx:id="emailColumn" />
                        <TableColumn text="Vehicle Type"   prefWidth="95"  fx:id="vehicleTypeColumn" />
                        <TableColumn text="Vehicle Number" prefWidth="100" fx:id="vehicleNumberColumn" />
                        <TableColumn text="Status"         prefWidth="80"  fx:id="statusColumn" />
                        <TableColumn text="Address"        prefWidth="110" fx:id="addressColumn" />
                        <TableColumn text="Joining Date"   prefWidth="95"  fx:id="joiningDateColumn" />
                        <TableColumn text="Salary"         prefWidth="75"  fx:id="salaryColumn" />
                        <TableColumn text="Rating"         prefWidth="65"  fx:id="ratingColumn" />
                        <TableColumn text="Actions"        prefWidth="170" fx:id="actionsColumn" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>