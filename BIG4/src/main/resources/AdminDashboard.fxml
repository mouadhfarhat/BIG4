<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controllers.AdminDashboardController"
           style="-fx-background-color: #f5f5f5;">

    <ScrollPane fitToWidth="true"
                fitToHeight="false"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                style="-fx-background: #f5f5f5; -fx-background-color: #f5f5f5;">
        <content>
            <VBox spacing="14" style="-fx-background-color: #f5f5f5;">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <HBox alignment="TOP_LEFT" spacing="14">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Admin Dashboard"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: rgb(1,10,34);"/>
                        <Label text="Overview of inventory and waste performance"
                               style="-fx-font-size: 13; -fx-text-fill: #666;"/>
                    </VBox>

                          <VBox spacing="3" prefWidth="320" maxHeight="112"
                             style="-fx-background-color: linear-gradient(to right, #1d4ed8, #2563eb); -fx-background-radius: 14; -fx-padding: 10 18 10 18;">
                           <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Live Weather"
                                style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #dbeafe;"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="weatherStatusLabel" text="Weather API: --"
                                style="-fx-font-size: 11; -fx-text-fill: #bfdbfe;"/>
                           </HBox>
                           <HBox alignment="CENTER_LEFT" spacing="14">
                            <Label fx:id="weatherTempLabel" text="-- °C"
                                style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label fx:id="weatherDemandLabel" text="Demand x--"
                                style="-fx-font-size: 12; -fx-text-fill: #e2e8f0;"/>
                            <Label fx:id="weatherExpiryLabel" text="Expiry x--"
                                style="-fx-font-size: 12; -fx-text-fill: #e2e8f0;"/>
                           </HBox>
                          </VBox>
                </HBox>

                <HBox spacing="14">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                        <Label text="Total Ingredients" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="totalIngredientsLabel" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                        <Label text="Low Stock Items" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="lowStockLabel" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                        <Label text="Expired Items" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="expiredItemsLabel" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                        <Label text="Waste Records" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="wasteRecordsLabel" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                    </VBox>
                </HBox>

                <HBox spacing="14">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                        <Label text="Inventory Value" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="inventoryValueLabel" text="\$0.00" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: rgb(1,10,34);"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                        <Label text="Total Waste Quantity" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="totalWasteQtyLabel" text="0.00" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: rgb(1,10,34);"/>
                    </VBox>
                </HBox>

                <HBox spacing="14">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                        <Label text="Waste by Type" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: rgb(1,10,34);"/>
                        <PieChart fx:id="wasteTypePieChart" prefHeight="280" legendVisible="true"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                        <Label text="Stock Health" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: rgb(1,10,34);"/>
                        <PieChart fx:id="stockStatusPieChart" prefHeight="280" legendVisible="true"/>
                    </VBox>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                    <Label text="Top Wasted Ingredients" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: rgb(1,10,34);"/>
                    <BarChart fx:id="topWastedBarChart" prefHeight="320" legendVisible="true">
                        <xAxis><CategoryAxis label="Ingredient"/></xAxis>
                        <yAxis><NumberAxis label="Quantity"/></yAxis>
                    </BarChart>
                </VBox>

                <Label text="Tip: Use the floating chat icon for shortage checks, expiry estimation, and reorder help."
                       style="-fx-font-size: 12; -fx-text-fill: #64748b;"/>
            </VBox>
        </content>
    </ScrollPane>

    <StackPane StackPane.alignment="BOTTOM_RIGHT"
               onMouseClicked="#handleOpenAiChat"
               pickOnBounds="false"
               prefWidth="58" prefHeight="58"
               maxWidth="58" maxHeight="58"
               style="-fx-background-color: white; -fx-background-radius: 999; -fx-cursor: hand; -fx-border-color: #2563eb; -fx-border-width: 2; -fx-border-radius: 999; -fx-effect: dropshadow(gaussian, rgba(37, 99, 235, 0.35), 16, 0.2, 0, 4);">
        <StackPane.margin>
            <Insets bottom="18" right="18"/>
        </StackPane.margin>
        <children>
            <ImageView fx:id="aiChatLauncher" fitHeight="36" fitWidth="36" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@images/logo.png" />
                </image>
            </ImageView>
        </children>
    </StackPane>

</StackPane>
